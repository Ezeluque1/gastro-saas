# Copiar a .env y completar. La app no arranca si falta una variable
# requerida (docs/Backend: "Configuracion").

NODE_ENV=test
PORT=3000

# Origen publico del frontend. Se usa en la verificacion CSRF.
APP_ORIGIN=http://localhost:3000

# Rol SIN privilegios con el que se conecta la aplicacion. Las politicas RLS
# lo alcanzan: nunca usar aca el rol migrador ni un superusuario.
DATABASE_URL=postgresql://gastro_app:app_dev@localhost:5434/gastro_test

# Rol migrador, dueno de las tablas. Lo usa solo la CLI de Prisma.
DATABASE_MIGRATION_URL=postgresql://gastro_migrator:migrator_dev@localhost:5434/gastro_test

LOG_LEVEL=silent

# Limite del cuerpo JSON.
BODY_LIMIT=100kb

# Better Stack (SDK compatible con Sentry). Si esta vacio, el modulo de
# monitoreo queda inactivo y no se envia nada.
MONITORING_DSN=
