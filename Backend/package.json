{
  "name": "saas-gastro-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:local": "npm run db:up && npm run db:deploy:test && vitest run",
    "test:watch": "vitest",
    "db:up": "docker compose up -d --wait db",
    "db:down": "docker compose down",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:deploy:test": "cross-env NODE_ENV=test prisma migrate deploy",
    "db:reset": "prisma migrate reset --force",
    "coverage": "vitest run --coverage",
    "monitoring:test": "tsx src/scripts/force-error.ts",
    "create-tenant": "tsx src/scripts/create-tenant.ts"
  },
  "overrides": {
    "effect": "3.22.5"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@sentry/node": "^11.18.0",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.5",
    "helmet": "^8.3.0",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.10",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^5.1.2",
    "cross-env": "^10.1.0",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "pino-pretty": "^13.2.0",
    "prettier": "^3.10.1",
    "prisma": "^7.10.1",
    "supertest": "^7.3.2",
    "tsx": "^4.23.15",
    "typescript": "~5.9",
    "typescript-eslint": "^8.74.0",
    "vitest": "^5.1.2"
  }
}
